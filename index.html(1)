<style>
/* Conceito: palco escuro com o M da Melkory como protagonista, o KORY como narrador e seções em vidro com brilho ciano. */
:root{
  --bg:#070B14; --bg2:#0B1220;
  --ink:#EAF2FF; --muted:rgba(234,242,255,.74); --faint:rgba(234,242,255,.52);
  --line:rgba(255,255,255,.12); --glass:rgba(255,255,255,.05); --glass2:rgba(255,255,255,.085);
  --blue:#2B6BFF; --cyan:#22D3EE; --cyan-d:#06B6D4;
  --grad:linear-gradient(135deg,#22D3EE,#5B93FF);
  --display:'Sora',system-ui,-apple-system,'Segoe UI',sans-serif;
  --body:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;
  --r:20px; --r2:14px; --max:1180px;
  --ring:0 0 0 3px rgba(34,211,238,.28);
  --danger:#FCA5A5;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background-color:var(--bg);color:var(--ink);font:400 16px/1.6 var(--body);-webkit-font-smoothing:antialiased;overflow-x:hidden}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:70;background:rgba(7,11,20,.92)}
.glow{position:fixed;inset:0;z-index:-1;pointer-events:none;background:
  radial-gradient(1200px 600px at 15% -10%,rgba(34,211,238,.18),transparent 60%),
  radial-gradient(900px 520px at 90% 0%,rgba(43,107,255,.18),transparent 55%),
  radial-gradient(800px 520px at 40% 105%,rgba(43,107,255,.12),transparent 55%),
  linear-gradient(180deg,var(--bg),var(--bg2))}
a{color:inherit;text-decoration:none}
img,svg{max-width:100%}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--cyan);outline-offset:3px;border-radius:8px}
h1,h2,h3{font-family:var(--display);margin:0;text-wrap:balance}
p{margin:0}
.wrap{width:100%;max-width:var(--max);margin-inline:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.section{padding-block:84px;scroll-margin-top:72px}
.section.tight{padding-block:56px}
.grid{display:grid;gap:18px}
.skip{position:absolute;left:-999px;top:10px;padding:10px 14px;background:#0f1b32;border:1px solid var(--line);border-radius:12px;z-index:100}
.skip:focus{left:10px}

/* botões */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;padding:12px 18px;border-radius:14px;border:1px solid var(--line);background:var(--glass);color:var(--ink);font:600 14px/1 var(--body);cursor:pointer;white-space:nowrap;transition:transform .15s ease,background .15s ease,border-color .15s ease}
.btn:hover{transform:translateY(-1px);border-color:rgba(34,211,238,.4);background:rgba(34,211,238,.09)}
.btn-primary{border-color:rgba(34,211,238,.4);background:linear-gradient(135deg,rgba(34,211,238,.2),rgba(43,107,255,.16))}
.btn-solid{background:var(--grad);color:#03111f;border-color:transparent;font-weight:700;box-shadow:0 14px 40px rgba(34,211,238,.22)}
.btn-solid:hover{background:var(--grad);border-color:transparent;filter:brightness(1.07)}
.dot{width:10px;height:10px;border-radius:99px;background:var(--cyan);box-shadow:0 0 0 3px rgba(34,211,238,.18),0 0 24px rgba(34,211,238,.5);flex:0 0 auto}
.btn-solid .dot{background:#03111f;box-shadow:none}

/* topo */
header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:60;background:rgba(7,11,20,.7);border-bottom:1px solid rgba(255,255,255,.08);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-block:12px}
.brand{display:flex;align-items:center;gap:12px;min-width:0}
.brand img{width:44px;height:auto;display:block}
.brand b{display:block;font:800 15px/1.1 var(--display);letter-spacing:.01em}
.brand small{display:block;margin-top:3px;color:var(--faint);font-size:12px;line-height:1.1}
nav.main{display:flex;gap:4px}
nav.main a{padding:10px 12px;border-radius:12px;color:var(--muted);font-weight:600;font-size:14px;border:1px solid transparent}
nav.main a:hover{color:var(--ink);background:var(--glass);border-color:var(--line)}
.bar-cta{display:flex;align-items:center;gap:10px}
.burger{display:none;width:44px;height:44px;align-items:center;justify-content:center;border-radius:14px;border:1px solid var(--line);background:var(--glass);cursor:pointer}
#mobileMenu{padding-bottom:14px}
#mobileMenu .links{display:grid;gap:8px}
#mobileMenu a{padding:14px 16px;border-radius:14px;border:1px solid var(--line);background:var(--glass);font-weight:600}

/* hero */
.hero{padding-block:48px 40px}
.hero-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:40px;align-items:center}
.eyebrow{display:inline-flex;align-items:center;gap:10px;padding:9px 14px;border-radius:99px;border:1px solid var(--line);background:var(--glass);font:600 12.5px/1 var(--body);color:rgba(234,242,255,.9)}
h1{margin-top:18px;font-size:clamp(2.1rem,5vw,3.75rem);line-height:1.04;letter-spacing:-.03em;font-weight:700}
.grad{background:linear-gradient(90deg,#EAF2FF,#22D3EE 45%,#2B6BFF);-webkit-background-clip:text;background-clip:text;color:transparent}
.lead{margin-top:18px;max-width:56ch;color:var(--muted);font-size:1.0625rem;line-height:1.65}
.lead b{color:var(--ink);font-weight:600}
.cta-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}
.meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:30px}
.meta div{padding:16px 14px;border-radius:var(--r2);border:1px solid var(--line);background:var(--glass)}
.meta svg{width:22px;height:22px;stroke:var(--cyan);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;margin-bottom:10px;display:block}
.meta strong{display:block;font:600 14.5px/1.25 var(--display)}
.meta span{display:block;margin-top:5px;color:var(--muted);font-size:13px;line-height:1.45}

.stage-col{min-width:0}
.stage{position:relative;border-radius:28px;padding:1px;background:linear-gradient(160deg,rgba(34,211,238,.6),rgba(255,255,255,.08) 40%,rgba(43,107,255,.55));box-shadow:0 30px 80px rgba(0,0,0,.5),0 0 90px rgba(34,211,238,.12);transform:perspective(1100px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .25s ease-out}
.stage img{display:block;width:100%;height:auto;border-radius:27px;aspect-ratio:1100/658;object-fit:cover;background:#05070d}
.chip{position:absolute;padding:7px 12px;border-radius:99px;border:1px solid rgba(255,255,255,.18);background:rgba(7,11,20,.72);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);font:600 12px/1 var(--body);color:var(--ink);display:flex;align-items:center;gap:8px;animation:bob 5s ease-in-out infinite}
.chip i{width:7px;height:7px;border-radius:99px;background:var(--cyan);box-shadow:0 0 12px var(--cyan)}
.chip.a{left:14px;top:14px}
.chip.b{right:14px;top:58px;animation-delay:-1.6s}
.chip.c{left:14px;top:54px;animation-delay:-3.2s}
@keyframes bob{50%{transform:translateY(-6px)}}
.kory-row{position:relative;display:flex;align-items:flex-end;gap:10px;margin-top:16px;padding-inline:0}
.bubble{flex:1;min-width:0;position:relative;padding:16px 18px;border-radius:20px 20px 6px 20px;border:1px solid var(--line);background:rgba(11,18,32,.86);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:0 16px 40px rgba(0,0,0,.35)}
.bubble .who{display:flex;align-items:center;gap:8px;margin-bottom:6px;font:700 12px/1 var(--display);letter-spacing:.08em;text-transform:uppercase;color:var(--cyan)}
.bubble p{font-size:14px;line-height:1.55;color:rgba(234,242,255,.9);min-height:4.6em}
.bubble .caret{display:inline-block;width:2px;height:1em;background:var(--cyan);margin-left:2px;vertical-align:-2px;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
.kory-wrap{flex:0 0 auto;width:150px}
.kory{display:block;width:100%;height:auto;overflow:visible}

/* KORY animado */
.k-float{animation:kfloat 4.2s ease-in-out infinite}
.k-shadow{animation:kshadow 4.2s ease-in-out infinite;transform-origin:240px 394px}
.k-arm-l{transform-origin:126px 238px;animation:kwave 2.2s ease-in-out infinite}
.k-eyes{transform-origin:240px 214px;animation:kblink 5.5s infinite}
.k-open{opacity:0;transform-origin:240px 264px}
.kory.talking .k-smile{opacity:0}
.kory.talking .k-open{opacity:1;animation:ktalk .26s ease-in-out infinite alternate}
.k-glow{animation:kglow 2.4s ease-in-out infinite}
@keyframes kfloat{50%{transform:translateY(-9px)}}
@keyframes kshadow{50%{transform:scale(.88);opacity:.3}}
@keyframes kwave{0%,100%{transform:rotate(0)}50%{transform:rotate(-13deg)}}
@keyframes kblink{0%,93%,100%{transform:scaleY(1)}96%{transform:scaleY(.08)}}
@keyframes ktalk{from{transform:scaleY(.35)}to{transform:scaleY(1.25)}}
@keyframes kglow{50%{opacity:.6}}

/* faixa de nichos */
.marquee{overflow:hidden;border-block:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.025);padding-block:16px;mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
.marquee .track{display:flex;gap:14px;width:max-content;animation:slide 38s linear infinite}
.marquee span{display:inline-flex;align-items:center;gap:14px;padding:9px 16px;border-radius:99px;border:1px solid var(--line);background:var(--glass);color:var(--muted);font-weight:600;font-size:14px;white-space:nowrap}
.marquee span::before{content:"";width:6px;height:6px;border-radius:99px;background:var(--cyan)}
@keyframes slide{to{transform:translateX(calc(-50% - 7px))}}

/* títulos de seção */
.head{display:flex;flex-direction:column;gap:12px;margin-bottom:34px;max-width:720px}
.kicker{display:inline-flex;align-items:center;gap:10px;font:700 12px/1 var(--display);letter-spacing:.14em;text-transform:uppercase;color:var(--cyan)}
.kicker::before{content:"";width:22px;height:2px;border-radius:2px;background:var(--cyan)}
.head h2{font-size:clamp(1.6rem,3.4vw,2.5rem);line-height:1.12;letter-spacing:-.025em;font-weight:700}
.head p{color:var(--muted);font-size:1.0625rem;line-height:1.6;max-width:60ch}

/* cartões */
.card{position:relative;isolation:isolate;overflow:hidden;border-radius:var(--r);border:1px solid var(--line);background:var(--glass);box-shadow:0 10px 30px rgba(0,0,0,.22);transition:border-color .2s ease,transform .2s ease}
.card::before{content:"";position:absolute;inset:0;z-index:-1;opacity:0;transition:opacity .25s ease;background:radial-gradient(420px circle at var(--mx,50%) var(--my,0%),rgba(34,211,238,.16),transparent 62%)}
@media (hover:hover){.card:hover::before{opacity:1}.card:hover{border-color:rgba(34,211,238,.32)}}
.pad{padding:24px}
.icon{width:46px;height:46px;border-radius:15px;border:1px solid rgba(255,255,255,.16);background:linear-gradient(135deg,rgba(34,211,238,.18),rgba(43,107,255,.1));display:grid;place-items:center;flex:0 0 auto}
.icon svg{width:22px;height:22px;stroke:var(--cyan);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.card h3{font-size:1.0625rem;font-weight:600;letter-spacing:-.01em}
.card p{color:var(--muted);font-size:14.5px;line-height:1.6}

/* por que um site */
.vs{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:stretch}
.vs .card{padding:28px}
.vs h3{font-size:1.2rem;margin-bottom:16px}
.vs ul{list-style:none;margin:0;padding:0;display:grid;gap:14px}
.vs li{display:flex;gap:12px;align-items:flex-start;font-size:15px;line-height:1.5}
.vs li svg{width:20px;height:20px;flex:0 0 auto;margin-top:2px;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.vs .no{opacity:.82}
.vs .no li{color:var(--muted)}
.vs .no li svg{stroke:#F59FA0}
.vs .yes{border-color:rgba(34,211,238,.4);background:linear-gradient(160deg,rgba(34,211,238,.1),rgba(43,107,255,.07));box-shadow:0 0 70px rgba(34,211,238,.1)}
.vs .yes li svg{stroke:var(--cyan)}
.quote{margin-top:30px;padding:22px 26px;border-radius:var(--r);border:1px solid var(--line);background:var(--glass);font:600 clamp(1.05rem,2.2vw,1.35rem)/1.4 var(--display);letter-spacing:-.01em;display:flex;gap:18px;align-items:center}
.quote svg{width:34px;height:34px;flex:0 0 auto;fill:var(--cyan);opacity:.9}

/* serviços */
.services{grid-template-columns:repeat(3,minmax(0,1fr))}
.svc{display:flex;flex-direction:column;gap:14px;padding:24px;min-width:0}
.svc .link{margin-top:auto;align-self:flex-start;display:inline-flex;align-items:center;gap:8px;padding:10px 0;background:none;border:0;color:var(--cyan);font:600 14px/1 var(--body);cursor:pointer}
.svc .link svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;transition:transform .2s}
.svc .link:hover svg{transform:translateX(4px)}

/* processo */
.steps{grid-template-columns:repeat(4,minmax(0,1fr));position:relative}
.step{padding:24px;display:flex;flex-direction:column;gap:12px;min-width:0}
.num{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;border:1px solid rgba(34,211,238,.35);background:rgba(34,211,238,.1);font:700 15px/1 var(--display);color:var(--ink);font-variant-numeric:tabular-nums}
.step h3{font-size:1.0625rem}
@media (min-width:981px){.step:not(:last-child)::after{content:"";position:absolute;right:-19px;top:44px;width:20px;height:2px;background:linear-gradient(90deg,rgba(34,211,238,.6),rgba(43,107,255,.2));z-index:2}}

/* projetos */
.projects{grid-template-columns:repeat(3,minmax(0,1fr))}
.proj{display:flex;flex-direction:column;min-width:0}
.thumb{position:relative;aspect-ratio:320/150;border-bottom:1px solid rgba(255,255,255,.1);background:radial-gradient(160px 90px at 12% 12%,rgba(34,211,238,.24),transparent 62%),radial-gradient(180px 100px at 88% 70%,rgba(43,107,255,.24),transparent 60%),linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.02));overflow:hidden}
.thumb svg{display:block;width:100%;height:100%}
.proj .body{padding:20px 22px 22px;display:flex;flex-direction:column;gap:10px;flex:1}
.proj h3{font-size:1.0625rem}
.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto;padding-top:6px}
.tag{padding:6px 11px;border-radius:99px;border:1px solid var(--line);background:var(--glass);font:600 12px/1 var(--body);color:rgba(234,242,255,.86)}

/* faq */
.faq{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}
details{border-radius:var(--r);border:1px solid var(--line);background:var(--glass);padding:0;transition:border-color .2s,background .2s}
details[open]{border-color:rgba(34,211,238,.35);background:rgba(34,211,238,.05)}
summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:18px 20px;font:600 15.5px/1.35 var(--display);letter-spacing:-.01em;min-height:60px}
summary::-webkit-details-marker{display:none}
.plus{width:32px;height:32px;border-radius:11px;border:1px solid var(--line);background:var(--glass2);display:grid;place-items:center;flex:0 0 auto;transition:transform .25s,background .2s}
.plus svg{width:14px;height:14px;stroke:var(--ink);stroke-width:2.2;stroke-linecap:round}
details[open] .plus{transform:rotate(45deg);background:rgba(34,211,238,.14);border-color:rgba(34,211,238,.4)}
details .ans{padding:0 20px 20px;color:var(--muted);font-size:14.5px;line-height:1.65}

/* contato */
.contact{grid-template-columns:1.1fr .9fr;gap:20px;align-items:start}
form{display:grid;gap:16px}
.row2{align-items:start;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.field{display:grid;gap:7px;min-width:0}
label{font:600 13.5px/1.2 var(--body);color:rgba(234,242,255,.92)}
input,textarea,select{width:100%;min-height:48px;padding:13px 14px;border-radius:14px;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.05);color:var(--ink);font:500 15px/1.4 var(--body);outline:none;transition:border-color .15s,box-shadow .15s,background .15s}
select option{background:#0B1220;color:#EAF2FF}
textarea{min-height:130px;resize:vertical}
input::placeholder,textarea::placeholder{color:var(--faint)}
input:focus,textarea:focus,select:focus{border-color:rgba(34,211,238,.55);box-shadow:var(--ring);background:rgba(34,211,238,.06)}
[aria-invalid="true"]{border-color:rgba(252,165,165,.75)}
.hint{color:var(--faint);font-size:12.5px;line-height:1.45}
.err{color:var(--danger);font-size:12.5px;line-height:1.4}
.lgpd{display:flex;gap:12px;align-items:flex-start;padding:16px;border-radius:16px;border:1px solid var(--line);background:rgba(255,255,255,.04);transition:box-shadow .2s}
.lgpd input{width:20px;min-height:20px;height:20px;margin-top:2px;accent-color:var(--cyan);flex:0 0 auto;padding:0}
.lgpd b{display:block;margin-bottom:4px;font-size:14px}
.result{padding:16px;border-radius:16px;border:1px solid rgba(34,211,238,.35);background:rgba(34,211,238,.07);font-size:14px;line-height:1.55;color:rgba(234,242,255,.92)}
.result .acts{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}
.side{padding:24px;display:grid;gap:18px}
.side-top{display:flex;align-items:center;gap:14px}
.side-top .kory-wrap{width:92px}
.side-top strong{display:block;font:700 1.05rem/1.2 var(--display)}
.side-top span{color:var(--muted);font-size:13.5px}
.ticks{display:grid;gap:11px}
.ticks div{display:flex;gap:11px;align-items:flex-start;color:rgba(234,242,255,.86);font-size:14px;line-height:1.45}
.ticks svg{width:18px;height:18px;flex:0 0 auto;margin-top:1px;stroke:var(--cyan);fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.channels{display:flex;flex-wrap:wrap;gap:10px}
.channels:empty{display:none}

/* rodapé */
footer{border-top:1px solid rgba(255,255,255,.1);background:rgba(7,11,20,.5);padding-block:44px 52px}
.foot{display:grid;grid-template-columns:1.2fr .8fr;gap:28px;align-items:start}
.foot img.logo{width:190px;height:auto;display:block}
.fine a{color:var(--cyan);text-decoration:underline;text-underline-offset:3px}
.fine{margin-top:16px;color:var(--muted);font-size:13.5px;line-height:1.7}
.fine b{color:var(--ink);font-weight:600}
.flinks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.flinks a{padding:12px 14px;border-radius:14px;border:1px solid var(--line);background:var(--glass);text-align:center;font-weight:600;font-size:14px}
.flinks a:hover{border-color:rgba(34,211,238,.4);background:rgba(34,211,238,.08)}

/* diálogos */
dialog{width:min(660px,calc(100% - 24px));max-height:88vh;padding:0;margin:auto;border-radius:24px;border:1px solid rgba(255,255,255,.16);background:#0B1220;color:var(--ink);box-shadow:0 40px 120px rgba(0,0,0,.7);overflow:hidden}
dialog[open]{display:flex;flex-direction:column}
dialog::backdrop{background:rgba(2,6,14,.72);backdrop-filter:blur(5px)}
.dh{display:flex;align-items:center;gap:14px;padding:16px 18px;border-bottom:1px solid rgba(255,255,255,.1);background:linear-gradient(180deg,rgba(34,211,238,.07),transparent)}
.dh .t{flex:1;min-width:0}
.dh .t b{display:block;font:700 1.05rem/1.2 var(--display)}
.dh .t span{color:var(--muted);font-size:13px}
.dh .kory-wrap{width:54px}
.db{padding:18px;overflow:auto;display:grid;gap:12px;align-content:start}
.msg{max-width:88%;padding:12px 15px;border-radius:18px;font-size:14.5px;line-height:1.5}
.msg.k{background:rgba(255,255,255,.07);border:1px solid var(--line);border-bottom-left-radius:6px}
.msg.u{justify-self:end;background:var(--grad);color:#03111f;font-weight:600;border-bottom-right-radius:6px}
.opts{display:flex;flex-wrap:wrap;gap:9px}
.opt{min-height:44px;padding:10px 15px;border-radius:99px;border:1px solid rgba(34,211,238,.4);background:rgba(34,211,238,.08);font:600 14px/1.2 var(--body);cursor:pointer;transition:background .15s,transform .15s}
.opt:hover{background:rgba(34,211,238,.18);transform:translateY(-1px)}
.brief{white-space:pre-wrap;padding:14px 16px;border-radius:14px;border:1px solid var(--line);background:rgba(255,255,255,.05);font-size:13.5px;line-height:1.6;color:rgba(234,242,255,.9)}
.acts{display:flex;flex-wrap:wrap;gap:10px}
pre.tpl{margin:12px 0 0;padding:14px;border-radius:14px;border:1px solid var(--line);background:rgba(255,255,255,.05);color:rgba(234,242,255,.9);font:500 13px/1.7 ui-monospace,SFMono-Regular,Menlo,monospace;overflow:auto;white-space:pre-wrap}
.db ul{margin:10px 0 0;padding-left:20px;color:var(--muted);line-height:1.7;font-size:14.5px}
.db p{color:var(--muted);font-size:14.5px;line-height:1.65}
html.lock{overflow:hidden}

/* movimento: o conteúdo já nasce visível, só se desloca */
.rise{transform:translateY(16px);transition:transform .6s cubic-bezier(.2,.7,.2,1)}
.rise.in{transform:none}

/* responsivo */
@media (max-width:1040px){
  nav.main{display:none}.burger{display:flex}
  .services,.projects{grid-template-columns:repeat(2,minmax(0,1fr))}
  .steps{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media (max-width:980px){
  .hero-grid{grid-template-columns:1fr;gap:34px}
  .contact,.foot,.vs{grid-template-columns:1fr}
  .faq{grid-template-columns:1fr}
}
@media (max-width:720px){
  .section{padding-block:60px}
  .services,.projects,.steps{grid-template-columns:1fr}
  .meta{grid-template-columns:1fr}
  .row2{grid-template-columns:1fr}
  .bar-cta .btn-primary{display:none}
  .kory-wrap{width:118px}
  .brand small{display:none}
  .chip.c{display:none}
  .quote{flex-direction:column;align-items:flex-start}
  .cta-row .btn{flex:1 1 100%}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation:none!important;transition:none!important}
  .marquee .track{flex-wrap:wrap;width:auto}
  .marquee{mask-image:none;-webkit-mask-image:none}
  .rise{transform:none}
}
</style>
