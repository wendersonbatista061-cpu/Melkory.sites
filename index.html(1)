    { key:'objetivo', q:'Qual é o principal objetivo?',        opts:['Vender mais','Mostrar meu trabalho','Receber contatos e pedidos','Organizar cardápio ou catálogo','Passar mais credibilidade'] },
    { key:'prazo',    q:'Qual é o prazo desejado?',            opts:['O quanto antes','Até 15 dias','Até 30 dias','Sem pressa'] },
    { key:'materiais',q:'Você já tem logo, fotos e textos?',   opts:['Tenho logo e fotos','Tenho só a logo','Ainda não tenho nada'] }
  ];
  var asBody = $('#asBody'), asDlg = $('#dlgAssistant'), ans, stepIdx;
  function koryOf(el){ return $('.kory', el); }
  function msg(cls, text){ var d = document.createElement('div'); d.className = 'msg ' + cls; d.textContent = text; asBody.appendChild(d); return d; }
  function scrollEnd(){ asBody.scrollTop = asBody.scrollHeight; }
  function say(text, cb){
    var k = koryOf(asDlg.querySelector('.dh')); if (k) k.classList.add('talking');
    var delay = reduce ? 0 : 520;
    setTimeout(function(){ msg('k', text); scrollEnd(); if (k) k.classList.remove('talking'); if (cb) cb(); }, delay);
  }
  function ask(){
    if (stepIdx >= STEPS.length) return finish();
    var s = STEPS[stepIdx];
    say(s.q, function(){
      var box = document.createElement('div'); box.className = 'opts';
      s.opts.forEach(function(o){
        var b = document.createElement('button'); b.type = 'button'; b.className = 'opt'; b.textContent = o;
        b.addEventListener('click', function(){ pick(s.key, o, box); });
        box.appendChild(b);
      });
      asBody.appendChild(box); scrollEnd();
      var first = box.firstChild; if (first) first.focus({preventScroll:true});
    });
  }
  function pick(key, val, box){
    ans[key] = val; if (box && box.parentNode) box.parentNode.removeChild(box);
    msg('u', val); stepIdx++; ask();
  }
  function briefText(){
    return 'Olá, Melkory.sites! Quero um projeto com estas informações:\n' +
      '• Tipo: ' + ans.tipo + '\n• Objetivo: ' + ans.objetivo + '\n• Prazo: ' + ans.prazo + '\n• Materiais: ' + ans.materiais +
      '\n\n(Briefing montado com o KORY)';
  }
  function finish(){
    var text = briefText();
    say('Pronto! Montei o seu briefing. Confira abaixo e escolha o que fazer:', function(){
      var b = document.createElement('div'); b.className = 'brief'; b.textContent = text; asBody.appendChild(b);
      var acts = document.createElement('div'); acts.className = 'acts';
      var use = document.createElement('button'); use.type = 'button'; use.className = 'btn btn-solid'; use.textContent = 'Usar no formulário';
      use.addEventListener('click', function(){
        var sel = $('#interesse'), found = false;
        $$('option', sel).forEach(function(o){ if (o.textContent === ans.tipo){ sel.value = o.textContent; found = true; } });
        if (!found) sel.value = 'Outro / Preciso de orientação';
        $('#mensagem').value = text;
        closeDlg(asDlg);
        var c = $('#contato'); if (c) c.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        setTimeout(function(){ $('#nome').focus({preventScroll:true}); }, reduce ? 0 : 600);
      });
      var cp = document.createElement('button'); cp.type = 'button'; cp.className = 'btn'; cp.textContent = 'Copiar briefing';
      cp.addEventListener('click', function(){ copyText(text, function(ok){ cp.textContent = ok ? 'Copiado!' : 'Selecione e copie o texto acima'; }); });
      acts.appendChild(use); acts.appendChild(cp);
      if (CONFIG.whatsapp){ var w = document.createElement('a'); w.className = 'btn'; w.href = waLink(text); w.target = '_blank'; w.rel = 'noopener'; w.textContent = 'Enviar pelo WhatsApp'; acts.appendChild(w); }
      if (CONFIG.email){ var em = document.createElement('a'); em.className = 'btn'; em.href = mailLink(text); em.textContent = 'Enviar por e-mail'; acts.appendChild(em); }
      var rs = document.createElement('button'); rs.type = 'button'; rs.className = 'btn'; rs.textContent = 'Recomeçar';
      rs.addEventListener('click', function(){ startAssistant(); });
      acts.appendChild(rs);
      asBody.appendChild(acts); scrollEnd(); use.focus({preventScroll:true});
    });
  }
  function startAssistant(pre){
    asBody.innerHTML = ''; ans = {}; stepIdx = 0;
    msg('k', 'Oi! Eu sou o KORY. Vou montar o seu briefing em quatro perguntas rápidas.');
    if (pre){ ans.tipo = pre; msg('u', pre); stepIdx = 1; }
    ask();
  }
  $$('[data-open]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var t = btn.getAttribute('data-open');
      if (t === 'assistant'){ setMenu(false); startAssistant(btn.getAttribute('data-service')); openDlg(asDlg); }
      else openInfo(t);
    });
  });

  /* ===== diálogos de informação ===== */
  var infoDlg = $('#dlgInfo');
  function openInfo(t){
    var title = $('#infoTitle'), sub = $('#infoSub'), body = $('#infoBody');
    body.innerHTML = '';
    if (t === 'lgpd'){
      title.textContent = 'LGPD: boas práticas'; sub.textContent = 'Transparência e minimização de dados.';
      body.innerHTML = '<p>Ao enviar o formulário, coletamos apenas os dados necessários para retornar o seu contato (por exemplo: nome, e-mail, interesse e mensagem). O objetivo é atender a sua solicitação com clareza e segurança.</p>' +
        '<ul><li><b>Finalidade:</b> responder solicitações e alinhar a proposta.</li><li><b>Minimização:</b> pedimos o mínimo para cumprir o atendimento.</li><li><b>Transparência:</b> informamos o motivo do contato no fluxo do formulário.</li><li><b>Controle:</b> você pode pedir esclarecimentos e, quando aplicável, exercer seus direitos.</li></ul>';
    } else {
      title.textContent = 'Modelo de briefing'; sub.textContent = 'Copie, preencha e cole no campo Mensagem.';
      var tplText = 'Objetivo: ...\nTipo: ...\nPúblico: ...\nPáginas/seções: ...\nDiferenciais: ...\nMateriais (fotos/textos): ...\nPrazo: ...\nIntegrações necessárias: ...';
      body.innerHTML = '<p>Você pode enviar assim. Com isso o KORY direciona a proposta com mais precisão.</p>';
      var pre = document.createElement('pre'); pre.className = 'tpl'; pre.textContent = tplText; body.appendChild(pre);
      var cb = document.createElement('button'); cb.type = 'button'; cb.className = 'btn'; cb.textContent = 'Copiar modelo';
      cb.addEventListener('click', function(){ copyText(tplText, function(ok){ cb.textContent = ok ? 'Copiado!' : 'Selecione e copie o texto acima'; }); });
      body.appendChild(cb);
    }
    openDlg(infoDlg);
  }

  /* ===== formulário ===== */
  var form = $('#contactForm'), result = $('#formResult');
  function flag(id, bad, input){ var e = $(id); e.hidden = !bad; if (input) input.setAttribute('aria-invalid', bad ? 'true' : 'false'); }
  form.addEventListener('submit', function(e){
    e.preventDefault();
    var nome = $('#nome'), email = $('#email'), tema = $('#interesse'), msgEl = $('#mensagem'), lg = $('#lgpd');
    var ok1 = nome.value.trim().length >= 2;
    var ok2 = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
    var ok3 = tema.value.trim().length > 0;
    var ok4 = msgEl.value.trim().length >= 10;
    var ok5 = lg.checked;
    flag('#errNome', !ok1, nome); flag('#errEmail', !ok2, email); flag('#errInteresse', !ok3, tema); flag('#errMsg', !ok4, msgEl); flag('#errLgpd', !ok5);
    if (!(ok1 && ok2 && ok3 && ok4 && ok5)){
      var firstBad = !ok1 ? nome : !ok2 ? email : !ok3 ? tema : !ok4 ? msgEl : lg;
      firstBad.focus();
      if (!ok5){ var box = $('#lgpdBox'); box.style.boxShadow = '0 0 0 3px rgba(239,68,68,.25)'; setTimeout(function(){ box.style.boxShadow = ''; }, 700); }
      return;
    }
    var full = 'Nome: ' + nome.value.trim() + '\nE-mail: ' + email.value.trim() + '\nWhatsApp: ' + ($('#whats').value.trim() || 'não informado') +
               '\nInteresse: ' + tema.value + '\n\n' + msgEl.value.trim();
    result.hidden = false; result.textContent = '';
    function note(t){ var p = document.createElement('div'); p.textContent = t; result.appendChild(p); }
    function acts(){ var d = document.createElement('div'); d.className = 'acts'; result.appendChild(d); return d; }
    function copyBtn(parent, label){
      var b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = label || 'Copiar mensagem';
      b.addEventListener('click', function(){ copyText(full, function(ok){ b.textContent = ok ? 'Copiado!' : 'Selecione e copie o texto'; }); });
      parent.appendChild(b);
    }
    if (CONFIG.endpoint){
      note('Enviando...');
      fetch(CONFIG.endpoint, { method:'POST', headers:{ 'Content-Type':'application/json', 'Accept':'application/json' },
        body: JSON.stringify({ nome:nome.value.trim(), email:email.value.trim(), whatsapp:$('#whats').value.trim(), interesse:tema.value, mensagem:msgEl.value.trim() }) })
        .then(function(r){ if (!r.ok) throw new Error('http'); result.textContent = ''; note('Mensagem enviada. Em breve retornaremos.'); form.reset(); })
        .catch(function(){ result.textContent = ''; note('Não foi possível enviar agora. Copie a mensagem e envie por outro canal.'); copyBtn(acts()); });
    } else if (CONFIG.whatsapp){
      note('Sua mensagem está pronta. Escolha como enviar: WhatsApp ou e-mail.');
      var a = acts(); var w = document.createElement('a'); w.className = 'btn btn-solid'; w.href = waLink(full); w.target = '_blank'; w.rel = 'noopener'; w.textContent = 'Abrir WhatsApp com a mensagem'; a.appendChild(w);
      if (CONFIG.email){ var em2 = document.createElement('a'); em2.className = 'btn'; em2.href = mailLink(full); em2.textContent = 'Enviar por e-mail'; a.appendChild(em2); }
      copyBtn(a);
    } else {
      note('Este formulário ainda não tem um canal de envio configurado. Copie a mensagem abaixo e envie pelo nosso contato.');
      var a2 = acts(); copyBtn(a2);
    }
  });
  ['nome','email','mensagem'].forEach(function(id){ $('#'+id).addEventListener('input', function(){ this.setAttribute('aria-invalid','false'); }); });

  /* ===== KORY no hero: frases digitadas ===== */
  var lines = [
    'Vamos deixar seu site pronto para vender, com design moderno, conteúdo bem estruturado e conformidade com LGPD. Me conte o que você precisa!',
    'Seu negócio pode ser pequeno, mas a forma como ele se apresenta não precisa ser.',
    'Você traz a ideia. Eu ajudo a transformar em um projeto pensado para o seu negócio.'
  ];
  var lineEl = $('#koryLine'), heroKory = $('#heroKory .kory'), li = 0;
  function typeLine(){
    var t = lines[li % lines.length]; li++;
    if (reduce){ lineEl.textContent = t; setTimeout(typeLine, 9000); return; }
    var i = 0; lineEl.textContent = ''; var cur = document.createElement('span'); cur.className = 'caret';
    heroKory.classList.add('talking');
    (function step(){
      lineEl.textContent = t.slice(0, i); lineEl.appendChild(cur);
      if (i++ < t.length) setTimeout(step, 26);
      else { heroKory.classList.remove('talking'); setTimeout(typeLine, 4200); }
    })();
  }
  if (lineEl && heroKory) typeLine();

  /* ===== brilho que segue o ponteiro nos cartões ===== */
  $$('.card').forEach(function(c){
    c.addEventListener('pointermove', function(e){
      var r = c.getBoundingClientRect();
      c.style.setProperty('--mx', (e.clientX - r.left) + 'px'); c.style.setProperty('--my', (e.clientY - r.top) + 'px');
    });
  });

  /* ===== inclinação suave do palco ===== */
  var stage = $('#stage');
  if (stage && !reduce && window.matchMedia('(hover:hover)').matches){
    stage.addEventListener('pointermove', function(e){
      var r = stage.getBoundingClientRect(), px = (e.clientX - r.left) / r.width - .5, py = (e.clientY - r.top) / r.height - .5;
      stage.style.setProperty('--ry', (px * 7).toFixed(2) + 'deg'); stage.style.setProperty('--rx', (-py * 6).toFixed(2) + 'deg');
    });
    stage.addEventListener('pointerleave', function(){ stage.style.setProperty('--rx','0deg'); stage.style.setProperty('--ry','0deg'); });
  }

  /* ===== entrada das seções (só deslocamento, o conteúdo já está visível) ===== */
  var rises = $$('.rise');
  if ('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(es){ es.forEach(function(en){ if (en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } }); }, { threshold: .12 });
    rises.forEach(function(r){ io.observe(r); });
    setTimeout(function(){ rises.forEach(function(r){ r.classList.add('in'); }); }, 4000);
  } else rises.forEach(function(r){ r.classList.add('in'); });
})();
</script>

</body>
</html>
